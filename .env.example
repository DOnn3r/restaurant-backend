# Copiez ce fichier vers .env puis changez TOUTES les valeurs.
POSTGRES_PASSWORD=changez-moi-mot-de-passe-base
# 32 caractères minimum, aléatoire (ex. : openssl rand -base64 48)
JWT_SECRET=changez-moi-secret-jwt-tres-long-et-aleatoire
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi-admin
# Fuseau horaire pour les statistiques par jour
APP_TIMEZONE=Indian/Antananarivo
# Port sur lequel l'API est exposée
BACKEND_PORT=8080
